{
  "name": "chatgpt",
  "publisher": "openai",
  "version": "0.0.0",
  "engines": {
    "vscode": "^1.96.0"
  },
  "main": "./extension.cjs",
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "codexSecondaryViewContainer",
          "title": "Fixture Codex",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "codexSecondaryViewContainer": [
        {
          "id": "codexNavigator.testSidebar",
          "name": "Fixture Codex Sidebar",
          "type": "webview"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "chatgpt.conversationEditor",
        "displayName": "Fixture Codex Chat",
        "selector": [
          {
            "filenamePattern": "openai-codex:/**/*"
          }
        ],
        "priority": "default"
      }
    ]
  }
}
