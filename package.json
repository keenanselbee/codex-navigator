{
  "name": "codex-navigator",
  "displayName": "Codex Navigator",
  "description": "Find and organise your Codex chats in a compact sidebar with project colours, favourites and activity indicators.",
  "version": "1.6.1",
  "publisher": "keenanselbee",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "codexNavigator.setUp",
        "title": "Set Up Codex Navigator",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.setUpAgentHelper",
        "title": "Set Up Routing",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.scopeMenu",
        "title": "Manage Chat Repository Scope",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.useAutomaticScope",
        "title": "Use Automatic Chat Scope",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.openSavedChat",
        "title": "Open Saved Codex Chat",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.assignRepository",
        "title": "Assign Repository to Chat",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.clearRepository",
        "title": "Clear Chat Repository",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.diagnostics",
        "title": "Show Navigator Status",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.setCustomLabel",
        "title": "Custom Label...",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.setRepositoryAlias",
        "title": "Set Repository Alias",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.associateLabelRepository",
        "title": "Associate Custom Label with Repository",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.toggleStar",
        "title": "Star / Unstar Chat",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.openStarredChats",
        "title": "Open Starred Chats",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.setChatColour",
        "title": "Chat Colour...",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.setRepositoryColour",
        "title": "Repository Colour...",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.showChats",
        "title": "Show Navigator",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.refreshChats",
        "title": "Refresh Navigator Chats",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.searchChats",
        "title": "Search Chats",
        "category": "Codex Navigator",
        "icon": "$(search)"
      },
      {
        "command": "codexNavigator.filterChats",
        "title": "Toggle Starred Chats",
        "category": "Codex Navigator",
        "icon": "$(star)"
      },
      {
        "command": "codexNavigator.newSidebarChat",
        "title": "New Chat in Codex",
        "category": "Codex Navigator",
        "icon": "$(add)"
      },
      {
        "command": "codexNavigator.sidebar.repositories",
        "title": "Choose Repository...",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.sidebar.label",
        "title": "Custom Label...",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.sidebar.colour",
        "title": "Chat Colour...",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.sidebar.associate",
        "title": "Associate Custom Label with Repository...",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.sidebar.automatic",
        "title": "Use Automatic Labels",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.sidebar.clear",
        "title": "Clear",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.setUpActivity",
        "title": "Set Up Activity Indicators",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.openSettings",
        "title": "Extension Settings",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.license",
        "title": "License",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.sidebar.hide",
        "title": "Hide Chat",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.restoreHiddenChats",
        "title": "Restore Hidden Chats...",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.showRepositoryColours",
        "title": "Repository Colours",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.sidebar.scope",
        "title": "Label Behaviour...",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.sidebar.repositoryColour",
        "title": "Change Colour...",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.sidebar.rename",
        "title": "Rename Chat...",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.sidebar.originalName",
        "title": "Original Chat Name...",
        "category": "Codex Navigator"
      },
      {
        "command": "codexNavigator.sidebar.resetName",
        "title": "Use Codex Name",
        "category": "Codex Navigator"
      }
    ],
    "menus": {
      "editor/title/context": [
        {
          "command": "codexNavigator.assignRepository",
          "when": "resourceScheme == openai-codex",
          "group": "codexNavigator"
        },
        {
          "command": "codexNavigator.setCustomLabel",
          "when": "resourceScheme == openai-codex",
          "group": "codexNavigator"
        },
        {
          "command": "codexNavigator.clearRepository",
          "when": "resourceScheme == openai-codex",
          "group": "codexNavigator"
        },
        {
          "command": "codexNavigator.toggleStar",
          "when": "resourceScheme == openai-codex",
          "group": "codexNavigator"
        },
        {
          "command": "codexNavigator.setChatColour",
          "when": "resourceScheme == openai-codex",
          "group": "codexNavigator"
        }
      ],
      "webview/context": [
        {
          "command": "codexNavigator.sidebar.repositories",
          "when": "webviewId == 'codexNavigator.chats' && webviewSection == navigatorChat",
          "group": "2_navigator@1"
        },
        {
          "command": "codexNavigator.sidebar.label",
          "when": "webviewId == 'codexNavigator.chats' && webviewSection == navigatorChat",
          "group": "2_navigator@2"
        },
        {
          "command": "codexNavigator.sidebar.colour",
          "when": "webviewId == 'codexNavigator.chats' && webviewSection == navigatorChat",
          "group": "2_navigator@3"
        },
        {
          "command": "codexNavigator.sidebar.associate",
          "when": "webviewId == 'codexNavigator.chats' && webviewSection == navigatorChat && navigatorHasCustomLabel",
          "group": "2_navigator@4"
        },
        {
          "command": "codexNavigator.sidebar.clear",
          "when": "webviewId == 'codexNavigator.chats' && webviewSection == navigatorChat",
          "group": "3_navigator@3"
        },
        {
          "command": "codexNavigator.sidebar.hide",
          "when": "webviewId == 'codexNavigator.chats' && webviewSection == navigatorChat",
          "group": "z_navigator_hide@1"
        },
        {
          "command": "codexNavigator.sidebar.scope",
          "when": "webviewId == 'codexNavigator.chats' && webviewSection == navigatorChat",
          "group": "3_navigator@2"
        },
        {
          "command": "codexNavigator.sidebar.repositoryColour",
          "when": "webviewId == 'codexNavigator.chats' && webviewSection == navigatorRepository",
          "group": "2_navigator@1"
        },
        {
          "command": "codexNavigator.sidebar.rename",
          "when": "webviewId == 'codexNavigator.chats' && webviewSection == navigatorChat",
          "group": "1_navigator_name@1"
        },
        {
          "command": "codexNavigator.sidebar.originalName",
          "when": "webviewId == 'codexNavigator.chats' && webviewSection == navigatorChat",
          "group": "1_navigator_name@2"
        },
        {
          "command": "codexNavigator.sidebar.resetName",
          "when": "webviewId == 'codexNavigator.chats' && webviewSection == navigatorChat && navigatorHasCustomName",
          "group": "1_navigator_name@3"
        }
      ],
      "commandPalette": [
        {
          "command": "codexNavigator.sidebar.repositories",
          "when": "false"
        },
        {
          "command": "codexNavigator.sidebar.label",
          "when": "false"
        },
        {
          "command": "codexNavigator.sidebar.colour",
          "when": "false"
        },
        {
          "command": "codexNavigator.sidebar.associate",
          "when": "false"
        },
        {
          "command": "codexNavigator.sidebar.automatic",
          "when": "false"
        },
        {
          "command": "codexNavigator.sidebar.clear",
          "when": "false"
        },
        {
          "command": "codexNavigator.sidebar.hide",
          "when": "false"
        },
        {
          "command": "codexNavigator.sidebar.scope",
          "when": "false"
        },
        {
          "command": "codexNavigator.sidebar.repositoryColour",
          "when": "false"
        },
        {
          "command": "codexNavigator.sidebar.rename",
          "when": "false"
        },
        {
          "command": "codexNavigator.sidebar.originalName",
          "when": "false"
        },
        {
          "command": "codexNavigator.sidebar.resetName",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "codexNavigator.license",
          "when": "view == codexNavigator.chats",
          "group": "1_navigator@7"
        },
        {
          "command": "codexNavigator.searchChats",
          "when": "view == codexNavigator.chats",
          "group": "navigation@1"
        },
        {
          "command": "codexNavigator.newSidebarChat",
          "when": "view == codexNavigator.chats",
          "group": "navigation@2"
        },
        {
          "command": "codexNavigator.filterChats",
          "when": "view == codexNavigator.chats",
          "group": "1_navigator@1"
        },
        {
          "command": "codexNavigator.showRepositoryColours",
          "when": "view == codexNavigator.chats",
          "group": "1_navigator@2"
        },
        {
          "command": "codexNavigator.refreshChats",
          "when": "view == codexNavigator.chats",
          "group": "1_navigator@3"
        },
        {
          "command": "codexNavigator.setUp",
          "when": "view == codexNavigator.chats",
          "group": "1_navigator@4"
        },
        {
          "command": "codexNavigator.openSettings",
          "when": "view == codexNavigator.chats",
          "group": "zz_navigator_settings@1"
        },
        {
          "command": "codexNavigator.restoreHiddenChats",
          "when": "view == codexNavigator.chats",
          "group": "1_navigator@6"
        }
      ]
    },
    "configuration": [
      {
        "id": "chatList.codexNavigator",
        "title": "Chat list",
        "order": 1,
        "properties": {
          "codexNavigator.recentChatsOnly": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Show chats used in the last 24 hours. Pinned chats and chats with unknown dates remain visible.",
            "order": 1
          },
          "codexNavigator.highlightMode": {
            "type": "string",
            "enum": [
              "off",
              "recent",
              "last"
            ],
            "enumItemLabels": [
              "Off",
              "Recently viewed chats",
              "Last viewed chat only"
            ],
            "default": "recent",
            "description": "Highlight chats opened through Navigator in their label colour. Does not track switches made inside Codex or change the hover outline.",
            "enumDescriptions": [
              "No visit highlights.",
              "Each visited chat fades independently.",
              "Only the most recently visited chat fades."
            ],
            "order": 2
          },
          "codexNavigator.highlightDurationSeconds": {
            "type": "integer",
            "default": 180,
            "minimum": 1,
            "maximum": 3600,
            "description": "How long each chat highlight fades, from 1 to 3600 seconds. Applies to both highlight modes. Revisiting a chat restarts its timer.",
            "order": 3
          }
        }
      },
      {
        "id": "labels.codexNavigator",
        "title": "Labels and colours",
        "order": 2,
        "properties": {
          "codexNavigator.agentRepositoryLabels": {
            "type": "boolean",
            "scope": "application",
            "default": false,
            "markdownDescription": "Follow repository reports from Codex. Enable [Automatic labels in setup](command:codexNavigator.setUp) to install the required guidance, then start a new chat. Turning this setting on alone does not install guidance.",
            "order": 1
          },
          "codexNavigator.keepManualLabelsFixed": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Keep new manual labels until you change them. When off, later repository reports can replace them. In multi-repository workspaces, repository choices follow reports unless you explicitly set this preference.",
            "order": 2
          },
          "codexNavigator.hideRedundantRepositoryLabels": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Hide automatic labels that repeat the only repository in this workspace. Labels you choose stay visible.",
            "order": 3
          },
          "codexNavigator.repositoryColours": {
            "type": "object",
            "scope": "application",
            "default": {},
            "additionalProperties": {
              "type": "string",
              "pattern": "^(none|#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}))$"
            },
            "markdownDescription": "Choose colours visually in [Repository Colours](command:codexNavigator.showRepositoryColours). Automatic colours are repeatable across settings resets; custom choices apply across workspaces.",
            "order": 4
          },
          "codexNavigator.repositoryAliases": {
            "type": "object",
            "default": {},
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "markdownDescription": "Friendly repository names. [Choose a repository to name](command:codexNavigator.setRepositoryAlias).",
            "order": 5
          }
        }
      },
      {
        "id": "instructions.codexNavigator",
        "title": "Project instructions",
        "order": 3,
        "properties": {
          "codexNavigator.instructionRouting": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "Help Codex find project rules. [Configure Project instructions in setup](command:codexNavigator.setUp) to install the required guidance. Turning this setting on alone does not complete setup.",
            "order": 1
          },
          "codexNavigator.mainInstructionsFile": {
            "type": "string",
            "default": "",
            "markdownDescription": "Optional shared rules file to read before project rules. [Choose a file in setup](command:codexNavigator.setUp), or leave blank for project rules only.",
            "order": 2
          },
          "codexNavigator.instructionScope": {
            "type": "array",
            "default": [],
            "maxItems": 64,
            "items": {
              "type": "string"
            },
            "markdownDescription": "Folders covered by project instructions. Empty uses this workspace; a parent folder includes its projects. [Choose folders in setup](command:codexNavigator.setUp).",
            "order": 3
          }
        }
      },
      {
        "id": "advanced.codexNavigator",
        "title": "Advanced",
        "order": 4,
        "properties": {
          "codexNavigator.detectChatFocus": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "Try to detect explicit repository switches in your messages when agent reports are missed. Editor tabs do not choose the repository.",
            "order": 1
          },
          "codexNavigator.silentMode": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Keep background warnings in Output instead of showing popups. Errors from commands you run still appear.",
            "order": 2
          },
          "codexNavigator.instructionFallbackNames": {
            "type": "array",
            "default": [],
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "markdownDescription": "Other rules filenames to try when AGENTS.override.md and AGENTS.md are absent. Most users can leave this empty.",
            "order": 3
          },
          "codexNavigator.highlightRecentlyViewedChats": {
            "type": "boolean",
            "default": true,
            "description": "Highlight chats opened through Navigator with their label colour, fading over Highlight Duration Seconds. Does not affect the hover outline.",
            "deprecationMessage": "Replaced by codexNavigator.highlightMode. Existing choices are migrated when Navigator starts.",
            "order": 4
          },
          "codexNavigator.highlightOnlyLastViewedChat": {
            "type": "boolean",
            "default": false,
            "description": "Highlight only the last chat opened through Navigator. Requires Highlight Recently Viewed Chats. Uses Highlight Duration Seconds.",
            "deprecationMessage": "Replaced by codexNavigator.highlightMode. Existing choices are migrated when Navigator starts.",
            "order": 5
          }
        }
      }
    ],
    "views": {
      "codexSecondaryViewContainer": [
        {
          "id": "codexNavigator.chats",
          "name": "Navigator",
          "type": "webview",
          "visibility": "visible",
          "icon": "media/icon.png"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node tools/compile.cjs",
    "build": "node tools/build.cjs",
    "test": "npm run compile && node --test tests/*.test.cjs",
    "test:public-only": "node tools/test-public-only.cjs",
    "test:commercial": "npm run build && node --test proprietary/tests/*.test.cjs",
    "test:integration": "npm run build && node tools/run-integration.cjs",
    "test:package": "npm run build && node tools/test-package.cjs",
    "test:installed": "npm run build && node tools/test-installed.cjs",
    "package": "node tools/package.cjs",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "5.9.3"
  },
  "author": {
    "name": "Keenan Selbee"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/keenanselbee/codex-navigator.git"
  },
  "homepage": "https://github.com/keenanselbee/codex-navigator#readme",
  "bugs": {
    "url": "https://github.com/keenanselbee/codex-navigator/issues"
  },
  "keywords": [
    "codex",
    "chat",
    "repository",
    "agents",
    "instructions"
  ],
  "icon": "media/icon.png"
}
